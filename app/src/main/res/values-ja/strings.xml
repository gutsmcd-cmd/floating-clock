<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">浮かぶ時計</string>
    <string name="tagline">どのアプリの上にも、小さな時計。</string>
    <string name="setup_title">はじめに、2つの許可</string>
    <string name="perm_overlay_title">1. 他のアプリの上に表示</string>
    <string name="perm_overlay_why">YouTube やゲームなど、どのアプリの上にも時計を出すために必要です。</string>
    <string name="perm_notif_title">2. 通知</string>
    <string name="perm_notif_why">通知欄に「表示」「隠す」「固定」ボタンを出します。</string>
    <string name="restricted_title">スイッチが灰色、または「制限付き設定」と出たら</string>
    <string name="restricted_body">Play ストア以外から入れたアプリは、Android がこの設定を制限します。最初の1回だけ：\n1. 下の「アプリ情報を開く」を押す\n2. 右上の ⋮ →「制限付き設定を許可」\n3. PIN や指紋で確認\n4. ここに戻り、もう一度「許可する」を押す</string>
    <string name="open_app_info">アプリ情報を開く</string>
    <string name="restricted_note">⋮ に「制限付き設定を許可」がないときは、上の「許可する」をもう一度押してから確認してください。機種によっては、一度ブロックされた後にだけ表示されます。</string>
    <string name="allow">許可する</string>
    <string name="clock_title">時計</string>
    <string name="show_clock">時計を表示</string>
    <string name="hide_clock">時計を隠す</string>
    <string name="start_failed">時計を表示できませんでした。「他のアプリの上に表示」の許可を確認してください。</string>
    <string name="add_tile">クイック設定にタイルを追加</string>
    <string name="tile_added">クイック設定にタイルがあります</string>
    <string name="tile_manual">クイック設定を開き、鉛筆（編集）を押して「浮かぶ時計」をドラッグしてください。</string>
    <string name="look_title">見た目</string>
    <string name="size_label">大きさ</string>
    <string name="size_tiny">極小</string>
    <string name="pinch_hint">ヒント：固定していないときは、時計を2本指でつまんで大きさを変えられます。サイズを選ぶとリセットされます。</string>
    <string name="size_s">小</string>
    <string name="size_m">中</string>
    <string name="size_l">大</string>
    <string name="color_label">文字の色</string>
